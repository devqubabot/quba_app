{
  "expo": {
    "name": "Quba",
    "slug": "quba",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "quba",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.quba.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.quba.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/presentation/assets/fonts/Nunito-Regular.ttf",
            "./src/presentation/assets/fonts/Nunito-Medium.ttf",
            "./src/presentation/assets/fonts/Nunito-SemiBold.ttf",
            "./src/presentation/assets/fonts/Nunito-Bold.ttf",
            "./src/presentation/assets/fonts/Nunito-ExtraBold.ttf",
            "./src/presentation/assets/fonts/Nunito-Black.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
